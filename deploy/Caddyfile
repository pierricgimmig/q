# Caddy reverse proxy for q serve. Replace the hostname, then:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
# Caddy obtains and renews the TLS certificate itself. Start q serve with
# --public-url https://q.example.com matching this hostname.
q.example.com {
    reverse_proxy 127.0.0.1:7777
}
